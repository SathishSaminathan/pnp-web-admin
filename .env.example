# ─── Required ────────────────────────────────────────────────────────────────
# Use /api with the Vite proxy (local backend on :4000), or a full Railway URL.
VITE_API_BASE_URL=/api

# ─── Optional: Application ───────────────────────────────────────────────────
VITE_APP_ENV=development
# Values: development, staging, production

# ─── Optional: Monitoring ────────────────────────────────────────────────────
VITE_MONITORING_ENABLED=false
VITE_MONITORING_SAMPLE_RATE=1.0

# Sentry
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_RATE=0.1

# Datadog
VITE_DATADOG_CLIENT_TOKEN=
VITE_DATADOG_APPLICATION_ID=
VITE_DATADOG_SITE=datadoghq.com

# NewRelic (requires browser agent script in index.html)
VITE_NEWRELIC_ACCOUNT_ID=
VITE_NEWRELIC_APPLICATION_ID=
VITE_NEWRELIC_LICENSE_KEY=

# ─── Optional: Feature Flags ─────────────────────────────────────────────────
# VITE_ENABLE_CIRCUIT_BREAKER=true
